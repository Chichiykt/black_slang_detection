# Relative paths are based on THIS PROJECT, independent of terminal/PyCharm cwd.
# Priority for app settings: external environment > this file > defaults.
PROJECT_NAME=laya-jargon-api
# Download the full model separately. Point to its local ROOT directory.
LAYA_MODEL_PATH=./models/laya-multilingual
LAYA_DEVICE=auto
API_HOST=127.0.0.1
API_PORT=8000
MAX_TEXT_LENGTH=2000
LAYA_MAX_TOKENS=4096

# Offline inference after installing dependencies. No online inference API.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
USE_TF=0

# Optional: all runtime/cache/temp paths have project-local defaults.
RUNTIME_DIR=./runtime
# APP_TEMP_DIR=./runtime/tmp
# HF_HOME=./runtime/cache/huggingface
# HF_HUB_CACHE=./runtime/cache/huggingface/hub
# HF_XET_CACHE=./runtime/cache/huggingface/xet
# TORCH_HOME=./runtime/cache/torch
# LOG_DIR=./runtime/logs

# Optional: GPU index or UUID. Respect externally assigned GPU visibility.
# CUDA_VISIBLE_DEVICES=0
